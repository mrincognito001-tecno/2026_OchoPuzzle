<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Prueba de Ocho Puzzle"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- FILA 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTN00"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN01"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN02"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN03"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- FILA 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTN10"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="12"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN11"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="13"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN12"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="14"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN13"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- FILA 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTN20"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="11"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN21"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN22"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="15"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN23"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- FILA 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/BTN30"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="10"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN31"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN32"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Button
                android:id="@+id/BTN33"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#26A69A"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/TXVMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Mensaje"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTNRestart"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF8F00"
            android:text="REINICIAR JUEGO"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTNShuffle"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF8F00"
            android:text="DESORDENAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTNVerify"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FF8F00"
            android:text="VERIFICAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>


